# Hugo site configuration
HUGO_BASE_URL=http://localhost:1313

# Paystack (test mode) - replace with your test keys
PAYSTACK_PUBLIC_KEY=your_paystack_public_test_key
PAYSTACK_SECRET_KEY=your_paystack_secret_test_key

# Google AdSense
ADSENSE_CLIENT_ID=ca-pub-your-adsense-id
ADSENSE_SLOT_TOP=1234567890
ADSENSE_SLOT_BOTTOM=0987654321

# Optional: Stripe if you ever want to switch (not used)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
